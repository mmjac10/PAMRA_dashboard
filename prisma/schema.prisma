// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
}

enum ProjectType {
  NEW
  MAINTENANCE_REPAIR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Subengineer {
  id           String       @id @default(cuid())
  name         String
  contact      String?
  email        String?      @unique
  passwordHash String?
  projects     Project[]
  siteUpdates  SiteUpdate[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  latitude        Float
  longitude       Float
  cost            Decimal       @db.Decimal(14, 2)
  status          ProjectStatus @default(IN_PROGRESS)
  health          ProjectHealth @default(ON_TRACK)
  type            ProjectType   @default(NEW)
  location        String?
  adminApproval   Decimal?      @db.Decimal(14, 2)
  workOrderAmount Decimal?      @db.Decimal(14, 2)
  workDoneAmount  Decimal?      @db.Decimal(14, 2)
  percentWorkDone Int?
  scopeItems      ScopeItem[]
  subengineer     Subengineer   @relation(fields: [subengineerId], references: [id])
  subengineerId   String
  bottlenecks     Bottleneck[]
  sitePhotos      SitePhoto[]
  siteUpdates     SiteUpdate[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([latitude, longitude])
  @@index([subengineerId])
}

model ScopeItem {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  item      String
  quantity  String?
  progress  String?
  order     Int      @default(0)

  @@index([projectId])
}

model Bottleneck {
  id          String             @id @default(cuid())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  description String
  createdAt   DateTime           @default(now())
  photos      BottleneckPhoto[]

  @@index([projectId])
}

model BottleneckPhoto {
  id           String     @id @default(cuid())
  bottleneck   Bottleneck @relation(fields: [bottleneckId], references: [id], onDelete: Cascade)
  bottleneckId String
  imageData    Bytes
  contentType  String
  createdAt    DateTime   @default(now())

  @@index([bottleneckId])
}

model SitePhoto {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  imageData   Bytes
  contentType String
  weekOf      DateTime
  uploadedAt  DateTime @default(now())

  @@index([projectId])
}

model SiteUpdate {
  id            String            @id @default(cuid())
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  subengineer   Subengineer       @relation(fields: [subengineerId], references: [id])
  subengineerId String
  remarks       String
  submittedAt   DateTime          @default(now())
  photos        SiteUpdatePhoto[]

  @@index([projectId])
  @@index([subengineerId])
}

model SiteUpdatePhoto {
  id           String     @id @default(cuid())
  siteUpdate   SiteUpdate @relation(fields: [siteUpdateId], references: [id], onDelete: Cascade)
  siteUpdateId String
  imageData    Bytes
  contentType  String
  createdAt    DateTime   @default(now())

  @@index([siteUpdateId])
}
