# Never send real secrets or local state into the Docker build context —
# env vars are injected at `docker run` time instead (see README/Dockerfile).
.env
.env.*
!.env.example

node_modules
.next
.git
.vscode
.idea

# Generated by prisma generate at build time inside the image.
src/generated

npm-debug.log*
*.tsbuildinfo
coverage
